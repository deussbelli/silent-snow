# Silent Snow - environment template
# Copy to .env.local and fill in real values. Never commit .env.local.

# Where pledge notifications are delivered.
PLEDGE_NOTIFY_TO=hello@example.org

# SMTP transport. Leave SMTP_HOST empty to run in log-only mode:
# pledges are still stored, the site keeps working, no mail is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Silent Snow <no-reply@example.org>"
